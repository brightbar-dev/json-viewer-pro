{
  "name": "json-viewer-pro",
  "description": "Clean, fast JSON viewer with tree view, search, and syntax highlighting. No ads, no tracking, no popups.",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:privacy": "node scripts/check-privacy.mjs .output/chrome-mv3 .output/firefox-mv2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
